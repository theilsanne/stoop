# Copy to app/.env.local for local development. Both values are public by design.
VITE_SUPABASE_URL=https://jjrjswxakuneoxipdswd.supabase.co
VITE_SUPABASE_ANON_KEY=
# Optional. A Google Maps Embed API key (public by design, locked to your site's address) makes
# Street view show outdoor imagery only. Without it the embed can land inside a shop.
VITE_GOOGLE_MAPS_KEY=
# Set to 1 to run on built-in sample data with no Supabase at all
VITE_DEMO=
